{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "roles.schema.json",
  "title": "E6 role annotation (one file per call)",
  "type": "object",
  "additionalProperties": false,
  "required": ["_meta", "call_id", "speaker_map", "evidence", "suspect_turns", "confidence"],
  "properties": {
    "_meta": {"$ref": "#/$defs/meta"},
    "call_id": {"type": "string", "pattern": "^C[0-9]{3}$"},
    "speaker_map": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^(SPK_[0-9]{2}|UNKNOWN)$"},
      "additionalProperties": {"$ref": "#/$defs/role"}
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["speaker", "turn_id", "quote"],
        "properties": {
          "speaker": {"type": "string", "pattern": "^(SPK_[0-9]{2}|UNKNOWN)$"},
          "turn_id": {"$ref": "#/$defs/turn_id"},
          "quote": {"type": "string", "minLength": 2}
        }
      }
    },
    "suspect_turns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["turn_id", "reason", "proposed_role"],
        "properties": {
          "turn_id": {"$ref": "#/$defs/turn_id"},
          "reason": {"type": "string", "minLength": 3, "maxLength": 300},
          "proposed_role": {"$ref": "#/$defs/role"}
        }
      }
    },
    "confidence": {"enum": ["high", "medium", "low"]}
  },
  "$defs": {
    "role": {"enum": ["AGENT", "CLIENT", "THIRD_PARTY", "SYSTEM", "UNKNOWN"]},
    "turn_id": {"type": "string", "pattern": "^T[0-9]{3,4}$"},
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["call_id", "annotator", "model", "claude_code_version", "codebook_sha256", "annotated_at"],
      "properties": {
        "call_id": {"type": "string", "pattern": "^C[0-9]{3}$"},
        "annotator": {"const": "claude-code"},
        "model": {"type": "string", "minLength": 1},
        "claude_code_version": {"type": "string", "minLength": 1},
        "codebook_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "annotated_at": {"type": "string", "format": "date-time"},
        "notes": {"type": "string"}
      }
    }
  }
}
