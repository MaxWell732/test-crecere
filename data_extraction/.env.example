# Copy to .env and fill in. Never commit .env — it is git-ignored.

# Hugging Face READ token, required by the E4 diarization stage (pyannote).
# Preferred: run `scripts/hf_login.sh`, which stores the token in
# .cache/huggingface/token (inside this project, never in $HOME).
# Set HF_TOKEN only if you cannot use the login helper.
# Create at https://huggingface.co/settings/tokens and accept the terms of:
#   pyannote/speaker-diarization-community-1
#   pyannote/speaker-diarization-3.1
#   pyannote/segmentation-3.0
HF_TOKEN=

# Filesystem confinement — normally exported by `source scripts/env.sh` and
# re-forced by the CLI at start-up. Override only to relocate the caches.
# HF_HOME=./.cache/huggingface
# TORCH_HOME=./.cache/torch
# XDG_CACHE_HOME=./.cache/xdg
# MPLCONFIGDIR=./.cache/matplotlib
# TMPDIR=./.cache/tmp
